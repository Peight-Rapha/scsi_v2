DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=<SECRET_KEY>
TIME_ZONE=America/Sao_Paulo
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,app
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0
DATABASE_URL=postgres://scsi:scsi@postgresql:5432/scsi
POSTGRES_DB=scsi
POSTGRES_USER=scsi
POSTGRES_PASSWORD=scsi
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=scsi
RABBITMQ_DEFAULT_PASS=scsi
RABBITMQ_DEFAULT_VHOST=scsi
CELERY_BROKER_URL=amqp://scsi:scsi@rabbitmq:5672/scsi
CELERY_RESULT_BACKEND=redis://redis:6379/1
EMAIL_HOST=<SMTP_HOST>
EMAIL_PORT=587
EMAIL_HOST_USER=<SMTP_USER>
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@scsi.digital
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=GPT-5.5-mini
CF_DNS_API_TOKEN_FILE=/run/secrets/CLOUDFLARE_DNS_API_TOKEN
GUNICORN_WORKERS=3
